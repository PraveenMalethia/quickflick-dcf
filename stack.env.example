# Stack env for quickflick
MONGO_URI=mongodb://CHANGE_ME:CHANGE_ME@mongodb:27017/quickflick?authSource=admin&replicaSet=rs0
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_INITDB_DATABASE=quickflick
ME_CONFIG_MONGODB_ADMINUSERNAME=admin
ME_CONFIG_MONGODB_ADMINPASSWORD=CHANGE_ME
ME_CONFIG_MONGODB_URL=mongodb://admin:CHANGE_ME@mongodb:27017/
JWT_KEY=CHANGE_ME_strong_random_min_32_chars
NODE_ENV=staging
# Dev OTP: 123456 on staging only when ENABLE_DEV_OTP=true (fail-closed; production ignores this)
ENABLE_DEV_OTP=true
PORT=3000
FRONTEND_URL=https://CHANGE_ME
LOW_STOCK_THRESHOLD=5
# Self-hosted OSRM router (quick-flick-osrm container, serves on :3000) — route polylines + ETA
# MLD algorithm: loads in ~1.2GB (CH needs ~2.5GB — OOM-killed in a crash loop
# on the 16GB dangal host, which has no swap). Data for BOTH algorithms is
# baked into the image; this env var selects MLD at container start.
OSRM_ALGORITHM=MLD
ROUTING_BASE_URL=http://osrm:3000/route/v1/driving
VITE_REACT_APP_BASE_URL=/admin/api
VITE_BASE_URL=/api

# ── GST invoice identifiers (BIZ-PAY-007) ──
# Real GSTIN printed on customer tax invoices. Leave empty to omit the GSTIN
# line entirely. NEVER ship a placeholder GSTIN.
QF_GSTIN=
# Default HSN code for grocery items (per-category HSN is post-launch)
QF_HSN_DEFAULT=
# ─── Dev OTP (staging only) ─────────────────────────────────────────────────
# OtpService issues the fixed dev OTP (123456, log-only, no SMS) only when
# ENABLE_DEV_OTP=true AND NODE_ENV != production. Fail-closed: without the flag
# staging takes the production branch and login breaks. Production ignores it.
# NOTE: the staging compose declares this in the backend service itself, because
# Portainer regenerates stack.env from its UI env list on every deploy.
ENABLE_DEV_OTP=true

# ─── Twilio (OTP SMS) — ONLY used when NODE_ENV=production. ──────────────────
# Staging (NODE_ENV=staging) NEVER sends SMS: OTP is fixed 123456, log-only.
# Fill these before the production stack goes live.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+91XXXXXXXXXX

# ─── Reverse-proxy trust (security audit 2026-09-15) ──────────────────────
# dangal/pi2 run behind nginx (one hop): trust it for correct client IPs in
# rate limiting. Direct-exposure deployments must LEAVE THIS UNSET.
TRUST_PROXY=1
